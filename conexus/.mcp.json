{
  "nexus": {
    "command": "uv",
    "args": [
      "tool",
      "run",
      "--directory",
      "${CLAUDE_PLUGIN_ROOT}",
      "--no-config",
      "--quiet",
      "--python",
      ">=3.12",
      "python",
      "${CLAUDE_PLUGIN_ROOT}/launch/nx_launch.py",
      "nx-mcp"
    ]
  },
  "nexus-catalog": {
    "command": "uv",
    "args": [
      "tool",
      "run",
      "--directory",
      "${CLAUDE_PLUGIN_ROOT}",
      "--no-config",
      "--quiet",
      "--python",
      ">=3.12",
      "python",
      "${CLAUDE_PLUGIN_ROOT}/launch/nx_launch.py",
      "nx-mcp-catalog"
    ],
    "alwaysLoad": false
  }
}
