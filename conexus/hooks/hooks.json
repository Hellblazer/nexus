{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "nx-hook",
            "args": [
              "upgrade-auto"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "nx-hook",
            "args": [
              "preflight"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "nx-hook",
            "args": [
              "self-gc"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "nx-hook",
            "args": [
              "session-start"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nx-hook",
            "args": [
              "session-context"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "nx-hook",
            "args": [
              "rdr"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/behaviour_census.py"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/version_lockstep_hook.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "nx-session-end-launcher",
            "args": [],
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [],
    "PostCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_post_compact",
            "input": {
              "session_id": "${session_id}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_stop_failure",
            "input": {
              "error": "${error}",
              "error_details": "${error_details}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_subagent_start",
            "input": {
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "task": "${task}"
            },
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_subagent_start_stamp",
            "input": {
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}"
            },
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_subagent_start_tuple",
            "input": {
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "task": "${task}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_subagent_stop",
            "input": {
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "agent_transcript_path": "${agent_transcript_path}",
              "stop_hook_active": "${stop_hook_active}"
            },
            "timeout": 10
          },
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_subagent_stop_tuple",
            "input": {
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_stop_verification",
            "input": {
              "session_id": "${session_id}"
            },
            "timeout": 180
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_pre_close_verification",
            "input": {
              "session_id": "${session_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}"
            },
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/routing/subagent_git_write_requires_orchestrator.py"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/routing/phase_review_close_requires_gate.py"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_agent_dispatch_expect",
            "input": {
              "session_id": "${session_id}",
              "tool_name": "${tool_name}",
              "tool_use_id": "${tool_use_id}",
              "tool_input": "${tool_input}"
            },
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__plugin_conexus_.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_auto_approve",
            "input": {
              "tool_name": "${tool_name}",
              "hook_event_name": "${hook_event_name}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_divergence_language_guard",
            "input": {
              "session_id": "${session_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__plugin_conexus_.*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_auto_approve",
            "input": {
              "tool_name": "${tool_name}",
              "hook_event_name": "${hook_event_name}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/mailbox_drain.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
