{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/nx_setup_notice.py"
            ],
            "timeout": 35
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/launch/nx_launch.py",
              "nx-hook",
              "upgrade-auto"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/launch/nx_launch.py",
              "nx-hook",
              "preflight"
            ],
            "timeout": 40
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/launch/nx_launch.py",
              "nx-hook",
              "self-gc"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/launch/nx_launch.py",
              "nx-hook",
              "session-start"
            ],
            "timeout": 40
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/launch/nx_launch.py",
              "nx-hook",
              "session-context"
            ],
            "timeout": 40
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/launch/nx_launch.py",
              "nx-hook",
              "rdr"
            ],
            "timeout": 40
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/version_lockstep_hook.py"
            ],
            "timeout": 35
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/nx_hook_shim.py",
              "mcp-connect-wait"
            ],
            "timeout": 50
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/launch/nx_launch.py",
              "nx-session-end-launcher"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:conexus:nexus",
            "tool": "hook_subagent_start",
            "input": {
              "session_id": "${session_id}",
              "agent_id": "${agent_id}",
              "agent_type": "${agent_type}",
              "task": "${task}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/routing/subagent_git_write_requires_orchestrator.py"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/routing/credential_print_guard.py"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_conexus_.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/nx_hook_shim.py",
              "auto-approve"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__plugin_conexus_.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/nx_hook_shim.py",
              "auto-approve"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/mailbox_drain.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
