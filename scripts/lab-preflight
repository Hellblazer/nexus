#!/usr/bin/env python3
# SPDX-License-Identifier: AGPL-3.0-or-later
# Copyright (c) 2026 Hal Hildebrand. All rights reserved.
"""Say, before a run is dispatched, that the command would be refused at once.

    python3 scripts/lab-preflight -- <argv...>

labrun's ``lab-remote`` runs this in the host copy after the sync (10 s cap) and
skips the dispatch on a non-zero exit, so a hand grant is not spent queueing for a
run that exits 75 within seconds. labrun-0uy.2.4: 151 hand grants on chas have ended
rc=75 since 10-18; of the 9 whose cause was read, 6 were "service jar not built"
(a lab-remote copy has no ``service/target/``), 2 a held service build lease and 1 a
held suite lease. This script stops the jar case; the lease refusals remain (a lease
can be gone by the time the run leaves the queue, so they only warn).

Exit 75, one stderr line naming the remedy, when BOTH hold:

  1. The argv is, as one simple command, a pytest run that gets as far as
     ``tests/conftest.py``'s session start, and ``NX_TEST_T2_SUBSTRATE`` can boot the
     engine (``_selected_t2_substrate_boots_engine``: anything but ``none`` and the
     retired values ``_RETIRED_T2_SUBSTRATES``; unset boots). The command word, after
     leading ``NAME=value`` words, ``env``, ``export``, ``uv run``, ``python -m`` and
     ``watched_pytest.py`` with its options up to ``--``, must itself be ``pytest`` or
     ``py.test``: ``uv pip install pytest``, ``echo pytest`` and ``grep pytest`` are not.
     A ``NX_TEST_T2_SUBSTRATE=<v>`` word before it (also after the wrapper's ``--``)
     wins over the environment, because ``lab-remote`` does not carry the environment.
     ``--help``, ``-h``, ``--version``, ``-V`` and ``--markers`` print and exit before
     any session starts, so they need no engine. ``-m lint`` and ``--collect-only`` do
     NOT exempt a run: the engine preflight (``_preflight_engine_substrate``) reads only
     that variable (measured 2026-11-22: both exit 75 on a checkout with no jar).
  2. The gate jar ``service/target/nexus-service-1.0-SNAPSHOT.jar`` is absent
     (``tests/db/_service_fixture.py`` ``_SERVICE_JAR``; ``jar_freshness_skip_reason``
     returns "service jar not built" on ``not jar.exists()``).

Otherwise exit 0. Fail open: a compound command (``&&``, ``||``, ``;``, ``|``, ``&``, a
newline, anywhere in the argv, a ``sh -c`` payload included) is not judged, because
the shell may build the jar first; and any error of this script's own exits 0, so a bug
here costs a wasted grant, never a refused good run.

Out of scope, so the conftest still refuses these after dispatch: a STALE or corrupt
jar (a synced copy's mtimes say nothing), the PG bundle, and a lease held by another
copy (the lease root lives in each copy's own git dir unless ``NX_BUILD_LEASE_ROOT``
is shared). A held suite lease (``tests/_suite_lease.py`` ``holder``) or a held service
build lease (``_service_fixture.build_in_progress_reason``) in THIS copy only warns on
stderr, exit 0.

Stdlib only, no network, no engine. The constants below are copies of the ones in
those two modules (this script must run where ``tests/`` cannot be imported with
nothing installed); ``tests/scripts/test_lab_preflight.py`` fails when they drift.
"""
from __future__ import annotations

import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

NO_ENGINE_SUBSTRATE = "none"
# Keys of tests/conftest.py _RETIRED_T2_SUBSTRATES: values refused by name, booting nothing.
RETIRED_SUBSTRATES = frozenset({"sqlite", "per-test", "engine"})
SUBSTRATE_ENV = "NX_TEST_T2_SUBSTRATE"
# tests/db/_service_fixture.py _SERVICE_JAR, relative to the repo root.
SERVICE_JAR = ("service", "target", "nexus-service-1.0-SNAPSHOT.jar")
BUILD_LEASE_ROOT_ENV = "NX_BUILD_LEASE_ROOT"
SUITE_LEASE = "suite"  # tests/_suite_lease.py RESOURCE
SERVICE_LEASE = "service"  # scripts/lib/build-lease.sh resource, read by build_in_progress_reason
POPULATE_GRACE_ENV = "_BUILD_LEASE_POPULATE_GRACE_S"
POPULATE_GRACE_DEFAULT_S = 10.0
EXIT_REFUSED = 75
GIT_TIMEOUT_S = 1.5

_PYTEST_WORDS = frozenset({"pytest", "py.test"})
_WRAPPER = "watched_pytest.py"
_NO_SESSION_FLAGS = frozenset({"--help", "-h", "--version", "-V", "--markers"})
_COMPOUND_MARKS = ("&&", "||", ";", "|", "\n", "\r")
_ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
_PYTHON = re.compile(r"^python[0-9.]*$")


def flatten(argv: list[str]) -> list[str]:
    """Split an argument that holds a whole command line (``'uv run pytest -x'``)."""
    out: list[str] = []
    for arg in argv:
        if any(ch.isspace() for ch in arg):
            try:
                out.extend(shlex.split(arg))
                continue
            except ValueError:
                pass
        out.append(arg)
    return out


def is_compound(words: list[str]) -> bool:
    """A shell list, pipe, background or newline anywhere: the command may build the jar first."""
    return any(mark in w for w in words for mark in _COMPOUND_MARKS) or "&" in words


#: ``env`` options that take no value. Any other option fails open (the value could read ``pytest``).
_ENV_FLAGS: frozenset[str] = frozenset({"-i", "--ignore-environment", "-0", "--null", "-v", "--debug"})
#: ``uv run`` options that take no value. Any other option fails open, as above.
_UV_RUN_FLAGS: frozenset[str] = frozenset({
    "--no-sync", "--frozen", "--locked", "--isolated", "--no-project", "--no-dev", "--all-extras",
    "--active", "--offline", "--no-cache", "-q", "--quiet", "-v", "--verbose", "--exact", "--no-config",
})


def locate_pytest(tokens: list[str]) -> tuple[list[str], str | None] | None:
    """``(words after the pytest command word, NX_TEST_T2_SUBSTRATE assigned before it)``, or ``None``.

    Walks the words that only prefix a command (``NAME=value``, ``env``, ``export``, ``uv run``,
    ``python -m``, ``watched_pytest.py`` and its options up to ``--``) and answers only when the
    command word reached is ``pytest`` or ``py.test`` itself.
    """
    selected: str | None = None
    i, n = 0, len(tokens)
    while i < n:
        tok = tokens[i]
        base = os.path.basename(tok)
        if _ASSIGNMENT.match(tok):
            name, _, value = tok.partition("=")
            if name == SUBSTRATE_ENV:
                selected = value.strip("'\"")
            i += 1
        elif base in ("env", "export"):
            i += 1
            while base == "env" and i < n and tokens[i].startswith("-"):
                if tokens[i] == "-u":
                    i += 2
                elif tokens[i] in _ENV_FLAGS:
                    i += 1
                else:
                    return None  # an option that may take a value: fail open rather than guess
        elif base == "uv" and tokens[i + 1 : i + 2] == ["run"]:
            i += 2
            while i < n and tokens[i].startswith("-"):
                if tokens[i] not in _UV_RUN_FLAGS:
                    return None  # --with, --extra, --python, ... take a value that could read "pytest"
                i += 1
        elif _PYTHON.match(base):
            i += 1
            if i < n and tokens[i] == "-m":
                i += 1
        elif base == _WRAPPER:
            if "--" not in tokens[i + 1 :]:
                return None
            i = tokens.index("--", i + 1) + 1
        elif base in _PYTEST_WORDS:
            return tokens[i + 1 :], selected
        else:
            return None
    return None


def substrate_boots_engine(selected: str | None) -> bool:
    """Same predicate as ``tests/conftest.py`` ``_selected_t2_substrate_boots_engine``."""
    return selected != NO_ENGINE_SUBSTRATE and selected not in RETIRED_SUBSTRATES


def needs_engine(argv: list[str], env: dict[str, str]) -> bool:
    """True when *argv* is one simple pytest command that reaches the conftest's engine preflight."""
    tokens = flatten(argv)
    if is_compound(argv) or is_compound(tokens):
        return False
    found = locate_pytest(tokens)
    if found is None:
        return False
    rest, assigned = found
    if any(tok in _NO_SESSION_FLAGS for tok in rest):
        return False  # prints help, a version or the marker list before any session starts
    return substrate_boots_engine(assigned if assigned is not None else env.get(SUBSTRATE_ENV))


def jar_path(repo_root: Path) -> Path:
    return repo_root.joinpath(*SERVICE_JAR)


def jar_present(repo_root: Path) -> bool:
    """``Path.exists``, so a dangling link is absent as for the conftest; a stat that fails otherwise (EACCES) is not proof of absence."""
    try:
        return jar_path(repo_root).exists()
    except OSError:
        return True


def _pid_alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _group_alive(pgid: int) -> bool:
    try:
        os.killpg(pgid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _field(path: Path) -> str:
    try:
        return path.read_text(errors="replace").strip()
    except OSError:
        return ""


def lease_root(repo_root: Path, env: dict[str, str]) -> Path:
    """``tests/db/_service_fixture.py`` ``_build_lease_root``: the override, else the git common dir's lease."""
    override = env.get(BUILD_LEASE_ROOT_ENV)
    if override:
        return Path(override)
    try:
        common = subprocess.run(
            ["git", "-C", str(repo_root), "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, check=True, timeout=GIT_TIMEOUT_S,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        common = ""
    if common:
        return Path(common) / "nexus-build-lease"
    return repo_root / "service" / ".build-lease"


def suite_lease_held(root: Path) -> str | None:
    """``tests/_suite_lease.py`` ``holder``: a live pid in ``<root>/suite/pid``; unreadable counts as held."""
    try:
        lease = root / SUITE_LEASE
        if not lease.is_dir():
            return None
        try:
            pid = int((lease / "pid").read_text().strip())
        except (FileNotFoundError, ValueError):
            return None
        except OSError:
            return "a holder whose lease files this user cannot read"
        if not _pid_alive(pid):
            return None
        label = _field(lease / "label")
        return f"pid {pid}" + (f" ({label})" if label else "")
    except PermissionError:
        return "a holder whose lease files this user cannot read"
    except Exception:  # noqa: BLE001 — a lease reader's bug must not block a dispatch
        return None


def build_lease_held(root: Path, repo_root: Path, env: dict[str, str]) -> str | None:
    """``_service_fixture.build_in_progress_reason`` for this checkout: who holds the service build lease."""
    try:
        lease = root / SERVICE_LEASE
        if not lease.is_dir():
            return None
        raw_pid, raw_pgid = _field(lease / "pid"), _field(lease / "pgid")
        if raw_pgid:
            if not (raw_pgid.isascii() and raw_pgid.isdigit() and _group_alive(int(raw_pgid))):
                return None
        elif raw_pid:
            if not (raw_pid.isascii() and raw_pid.isdigit() and _pid_alive(int(raw_pid))):
                return None
        else:
            try:
                grace = float(env.get(POPULATE_GRACE_ENV, POPULATE_GRACE_DEFAULT_S))
            except ValueError:
                grace = POPULATE_GRACE_DEFAULT_S
            if time.time() - lease.stat().st_mtime >= grace:
                return None
        builder = _field(lease / "worktree")
        if builder:
            try:
                if not os.path.samefile(builder, repo_root):
                    return None  # another checkout's build never rewrites this jar
            except (OSError, ValueError, RuntimeError):
                pass  # unreadable proves nothing: count it as this checkout's
        return f"pid {raw_pid or '<being populated>'} ({_field(lease / 'label') or 'unknown'})"
    except (OSError, ValueError, OverflowError):
        return None


def check(argv: list[str], env: dict[str, str], repo_root: Path) -> tuple[int, list[str]]:
    """Exit code and the stderr lines."""
    if not needs_engine(argv, env):
        return 0, []
    if not jar_present(repo_root):
        return EXIT_REFUSED, [
            f"lab-preflight: {'/'.join(SERVICE_JAR)} is not built, so this run would exit 75 at session start "
            "(engine substrate preflight); first run scripts/build-gate-jar.sh --lab-run <class> in the copy as its own step "
            f"(an engine build is not wrapped in lab-run), or set {SUBSTRATE_ENV}=none for a run that needs no engine"
        ]
    lines: list[str] = []
    root = lease_root(repo_root, env)
    if (who := suite_lease_held(root)) is not None:
        lines.append(f"lab-preflight: warning: the suite lease is held by {who}; the run may queue behind it")
    if (who := build_lease_held(root, repo_root, env)) is not None:
        lines.append(f"lab-preflight: warning: a service build holds the build lease ({who}); the run may refuse or wait for it")
    return 0, lines


def main(argv: list[str] | None = None, env: dict[str, str] | None = None, repo_root: Path | None = None) -> int:
    try:
        args = list(sys.argv[1:] if argv is None else argv)
        if args and args[0] == "--":
            args = args[1:]
        code, lines = check(
            args,
            dict(os.environ) if env is None else env,
            Path(__file__).resolve().parents[1] if repo_root is None else repo_root,
        )
    except Exception as exc:  # noqa: BLE001 — fail open: a bug here must cost a wasted grant, never a refused good run
        try:
            sys.stderr.write(f"lab-preflight: skipped on its own error: {exc!r}\n")
        except (OSError, AttributeError, ValueError):
            sys.stderr = None  # type: ignore[assignment]
        return 0
    try:
        for line in lines:
            sys.stderr.write(line + "\n")
        sys.stderr.flush()
    except (OSError, AttributeError, ValueError):
        sys.stderr = None  # type: ignore[assignment]  # a broken stderr must not turn the verdict into exit 1 or 120
    return code


if __name__ == "__main__":
    raise SystemExit(main())
