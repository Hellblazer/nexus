<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-zrcj7 (Sam's no-SQL-strings-in-Java directive, 2026-09-03). Pure
    retirement, no behaviour change.

    THE MOVE. BackendReaper#terminateOwnBackends (nexus-g17tf) used to run a
    raw PreparedStatement over a bare, non-pooled JDBC Connection at shutdown:

        SELECT pid, pg_terminate_backend(pid) FROM pg_stat_activity
         WHERE application_name = ? AND pid <> pg_backend_pid()

    This function is the identical statement, callable through jOOQ's
    generated table-function machinery (Tables.TERMINATE_OWN_BACKENDS.call(
    applicationName) in the generated dev.nexus.service.jooq.nexus.Tables) —
    BackendReaper now wraps its already-open, already-fresh Connection in a
    DSLContext (DSL.using(connection, SQLDialect.POSTGRES), the same idiom
    PoolerModeCheck/HealthHandler/VersionHandler already use for a
    bare-JDBC bootstrap connection) rather than building the raw string
    itself. The FRESH-connection / never-a-pool-borrow shutdown-safety
    property is unchanged: this only replaces how the ALREADY-OPEN
    connection's statement is built, not when or how the connection itself
    is acquired.

    Deliberately VOLATILE (the default, no STABLE/IMMUTABLE marking):
    pg_terminate_backend has a real side effect (sends SIGTERM to the
    target backend), so marking this STABLE or IMMUTABLE would misdescribe
    it to the planner, unlike the read-only combined-query / hybrid-search
    functions elsewhere in this changelog. SECURITY INVOKER (the default,
    stated explicitly to match convention): pg_terminate_backend's own
    permission check (same role as the target backend, or pg_signal_backend
    membership, or superuser) must run as the CALLING role, exactly as the
    raw statement did when executed directly on the reaper's own connection.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="backend-reaper-001-0" author="nexus-zrcj7">
        <comment>nexus.terminate_own_backends: table-valued function wrapping BackendReaper's pg_stat_activity + pg_terminate_backend shutdown statement, retiring its raw PreparedStatement</comment>
        <sql splitStatements="true">
CREATE OR REPLACE FUNCTION nexus.terminate_own_backends(p_application_name text)
    RETURNS TABLE(pid integer, terminated boolean)
    LANGUAGE sql
    SECURITY INVOKER
AS $$
    SELECT pid, pg_terminate_backend(pid) AS terminated
      FROM pg_stat_activity
     WHERE application_name = p_application_name
       AND pid &lt;&gt; pg_backend_pid()
$$;
        </sql>
        <rollback>
            <sql splitStatements="true">
DROP FUNCTION IF EXISTS nexus.terminate_own_backends(text);
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
