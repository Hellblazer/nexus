<?xml version="1.0" encoding="UTF-8"?>
<!--
    RDR-187 (bead nexus-piwya.9) — DROP nexus.chash_index, the router
    remnant of the split-store architecture.

    The chunks tables ARE the chash-keyed store: /v1/chash/* reads serve
    from them (nexus-piwya.3, conformance-gated as a strict SUPERSET of the
    router's answers), the dual-write hook and delete_stale self-heal are
    gone client-side (nexus-piwya.4), the census/gate/forensics legs are
    retired (nexus-piwya.5), the staging promote/landing legs are retired
    (nexus-piwya.7/.8), and the cold-path ETL leg is gone (nexus-piwya.10).
    Conexus's five direct readers landed ahead of this DROP (their PR #176,
    round-29 confirmation); their rdr164 cascade probe retargets in
    lockstep with this tag's CatalogRepository cascade-leg removal.

    AUDIT TRAIL — the orphan population dies HERE, by design: production
    measured 292,230 nexus.chash_index rows resolving by NO route (neither
    a chunks row nor a chash_alias fact — the post-kmd5b width-blind-fixed
    census, 2026-07-20, both cloud tenants). They are pointers to chunks
    deleted over the router's dual-write lifetime; every LIVE router fact
    is answered by the chunks tables. Recorded here per the RDR's
    audit-trail requirement (subsumes nexus-uu4ue step 2's DELETE — the
    remaining uu4ue scope is the 426 manifest rows + the final VALIDATE).

    DEPENDENT VIEW (rdr180-1 precedent, proven in the v0.1.49 production
    deploy): a deployed diag_chash_conformance view older than the 7-leg
    generation holds a hard dependency on this table — dropped IF EXISTS
    first. The client re-provisions the 7-leg form on its next provision
    pass (pg_provision auto-derives from CHASH_BEARING_TABLES, which lost
    its chash_index entry at nexus-piwya.5); managed deployments
    re-provision in the deploy window (conexus round-29). Meanwhile the
    health probe's legacy fallback statements (4-table post-.5) cover the
    view-absent window by design.

    PRECONDITION (catalog-013 discipline): sqlCheck-gated, MARK_RAN-safe —
    a store where the table is already gone (a future fresh-install
    generation after this changeset's own baseline stops creating it, or
    an out-of-band cleanup) marks ran instead of erroring.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="rdr187-1-drop-diag-view-dependency" author="nexus-piwya.9">
        <comment>Drop a pre-7-leg diag counts view holding a dependency on chash_index (rdr180-1 precedent; re-provisioned client-side/managed-side with the 7-leg generator)</comment>
        <sql>
DROP VIEW IF EXISTS nexus.diag_chash_conformance;
        </sql>
        <rollback/>
    </changeSet>

    <changeSet id="rdr187-2-drop-chash-index" author="nexus-piwya.9">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT count(*) FROM information_schema.tables WHERE table_schema = 'nexus' AND table_name = 'chash_index'</sqlCheck>
        </preConditions>
        <comment>DROP nexus.chash_index — the router is retired; the chunks tables are the chash store. The 292,230 orphaned pointers (post-kmd5b census, 2026-07-20) die here by design. Indexes, the octet CHECK, the collection FK, and the RLS policy die with the table.</comment>
        <sql>
DROP TABLE nexus.chash_index;
        </sql>
        <!--
            nexus-lelhx (round 3, EMPIRICALLY REQUIRED): the DATA (292,230
            orphans + the live rows' duplicate facts) is genuinely not
            recoverable and this rollback still does not attempt to restore
            it — that half of the original "documented no-op" reasoning
            stands. What changed: an EMPTY no-op rollback here left
            nexus.chash_index permanently absent for ANY rollback shallower
            than chash-001-baseline's own CREATE (master position ~60) but
            deep enough to reach catalog-013-chash-checks-validate.xml's
            catalog-013-0 (position ~207, a live consumer that DELETEs FROM
            nexus.chash_index on every forward pass) — breaking that
            changeset's forward re-apply with "relation nexus.chash_index
            does not exist" the moment rdr180-3/4/5's OWN rollback fix (this
            same nexus-lelhx bead) let a forward walk get far enough past
            catalog-006-4 to reach it. Previously masked entirely: migrate()
            always aborted earlier, at catalog-006-4, before ever reaching
            this changeset. So this rollback now recreates the SCHEMA SHAPE
            (table, both indexes, RLS + policy, the octet CHECK, the
            collection FK) exactly as it stood immediately before this
            changeset's own forward DROP (chash already BYTEA, since rdr180-7
            ran forward before this changeset in master order), WITHOUT
            attempting to repopulate the unrecoverable rows. A later,
            earlier-executed rollback (rdr180-7, master position ~274, rolls
            back AFTER this one in the reverse sequence since 299 > 274)
            then converts the recreated table's chash back to TEXT exactly
            as it does for chunks_384/768/1024 and catalog_document_chunks;
            the two rollbacks compose correctly in sequence. Same
            reversibility precedent as rdr180-3/4/5/6/7: identical shape to
            chash-001-1/chash-001-2 (chash-001-baseline.xml) plus
            rdr180-11's octet CHECK plus fk-002-4's collection FK,
            reassembled verbatim rather than re-derived, since this is
            exactly the union of every changeset that ever touched this
            table's SCHEMA before this DROP.
        -->
        <rollback>
            <sql splitStatements="true" stripComments="false">
CREATE TABLE nexus.chash_index (
    tenant_id           TEXT        NOT NULL,
    chash               BYTEA       NOT NULL,
    physical_collection TEXT        NOT NULL,
    created_at          TIMESTAMPTZ NOT NULL,
    CONSTRAINT chash_index_pk PRIMARY KEY (tenant_id, chash, physical_collection)
);

CREATE INDEX idx_chash_index_chash ON nexus.chash_index (tenant_id, chash);
CREATE INDEX idx_chash_index_collection ON nexus.chash_index (tenant_id, physical_collection);

ALTER TABLE nexus.chash_index ENABLE ROW LEVEL SECURITY;
ALTER TABLE nexus.chash_index FORCE ROW LEVEL SECURITY;
CREATE POLICY tenant_isolation ON nexus.chash_index
    USING      (tenant_id = current_setting('nexus.tenant', true))
    WITH CHECK (tenant_id = current_setting('nexus.tenant', true));

ALTER TABLE nexus.chash_index
    ADD CONSTRAINT chash_index_chash_octet_check CHECK (octet_length(chash) = 32) NOT VALID;

ALTER TABLE nexus.chash_index
    ADD CONSTRAINT chash_index_collection_fk
    FOREIGN KEY (tenant_id, physical_collection)
    REFERENCES nexus.catalog_collections (tenant_id, name)
    ON DELETE RESTRICT
    NOT VALID;
ALTER TABLE nexus.chash_index VALIDATE CONSTRAINT chash_index_collection_fk;
            </sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
