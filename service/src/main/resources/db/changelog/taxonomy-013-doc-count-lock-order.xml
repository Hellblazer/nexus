    <changeSet id="taxonomy-013-2" author="nexus-0uuit">
        <comment>topics_doc_count_recount_del: same fix, DELETE-path (fixes 40P01 deadlock, nexus-0uuit)</comment>
        <sql splitStatements="false" stripComments="false">
CREATE OR REPLACE FUNCTION nexus.topics_doc_count_recount_del()
    RETURNS TRIGGER
    LANGUAGE plpgsql
    SECURITY INVOKER
AS $fn$
DECLARE
    v_tenant_ids TEXT[];
    v_topic_ids  BIGINT[];
    v_i          INT;
BEGIN
    -- Materialize the distinct (tenant_id, topic_id) pairs FIRST, PRE-SORTED
    -- — same reasoning as the INSERT-path function above.
    SELECT array_agg(tenant_id ORDER BY tenant_id, topic_id),
           array_agg(topic_id  ORDER BY tenant_id, topic_id)
      INTO v_tenant_ids, v_topic_ids
      FROM (SELECT DISTINCT tenant_id, topic_id FROM old_rows) d;

    -- (1) CORRECTNESS: same single-row, join-free, PK-indexed lock loop as
    -- the INSERT-path function above (see its IMPLEMENTATION NOTE).
    FOR v_i IN 1 .. COALESCE(array_length(v_topic_ids, 1), 0) LOOP
        PERFORM 1 FROM nexus.topics
         WHERE tenant_id = v_tenant_ids[v_i] AND id = v_topic_ids[v_i]
           FOR UPDATE;
    END LOOP;

    -- (2) PROBABILITY: single batched-aggregate recompute, LEFT JOINed so a
    -- topic whose LAST assignment was just deleted (zero remaining rows,
    -- absent from the aggregate's GROUP BY) still resets to 0 rather than
    -- being skipped.
    UPDATE nexus.topics t
       SET doc_count = COALESCE(c.cnt, 0)
      FROM (SELECT DISTINCT tenant_id, topic_id FROM old_rows) a
      LEFT JOIN (
          SELECT ta.tenant_id, ta.topic_id, COUNT(*) AS cnt
            FROM nexus.topic_assignments ta
            JOIN (SELECT DISTINCT tenant_id, topic_id FROM old_rows) a2
              ON a2.tenant_id = ta.tenant_id AND a2.topic_id = ta.topic_id
           GROUP BY ta.tenant_id, ta.topic_id
      ) c ON c.tenant_id = a.tenant_id AND c.topic_id = a.topic_id
     WHERE t.tenant_id = a.tenant_id AND t.id = a.topic_id;
    RETURN NULL;
END;
$fn$;
        </sql>
