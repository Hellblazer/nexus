    <changeSet id="taxonomy-013-1" author="nexus-0uuit">
        <comment>topics_doc_count_recount_ins: deterministic ORDER BY FOR UPDATE lock acquisition + single batched-aggregate recompute (fixes 40P01 deadlock, nexus-0uuit)</comment>
        <sql splitStatements="false" stripComments="false">
CREATE OR REPLACE FUNCTION nexus.topics_doc_count_recount_ins()
    RETURNS TRIGGER
    LANGUAGE plpgsql
    SECURITY INVOKER
AS $fn$
DECLARE
    v_tenant_ids TEXT[];
    v_topic_ids  BIGINT[];
    v_i          INT;
BEGIN
    -- Materialize the distinct (tenant_id, topic_id) pairs FIRST, PRE-SORTED
    -- (ORDER BY inside array_agg itself — deterministic regardless of
    -- new_rows' own row order), in a statement carrying NO locking clause.
    SELECT array_agg(tenant_id ORDER BY tenant_id, topic_id),
           array_agg(topic_id  ORDER BY tenant_id, topic_id)
      INTO v_tenant_ids, v_topic_ids
      FROM (SELECT DISTINCT tenant_id, topic_id FROM new_rows) d;

    -- (1) CORRECTNESS: acquire every affected topics row lock up front, ONE
    -- ROW AT A TIME via a single-table, PK-indexed, join-free `FOR UPDATE`
    -- — see the IMPLEMENTATION NOTE above for why a JOIN-based `ORDER BY
    -- ... FOR UPDATE` does NOT reliably serialize this (PostgreSQL's
    -- LockRows node locks in JOIN order, not sorted order, once a join is
    -- involved). Iterating the PRE-SORTED arrays above one indexed
    -- single-row lock at a time is what actually guarantees every
    -- concurrent invocation acquires the shared topics in the same
    -- relative order.
    FOR v_i IN 1 .. COALESCE(array_length(v_topic_ids, 1), 0) LOOP
        PERFORM 1 FROM nexus.topics
         WHERE tenant_id = v_tenant_ids[v_i] AND id = v_topic_ids[v_i]
           FOR UPDATE;
    END LOOP;

    -- (2) PROBABILITY: recompute doc_count for every affected topic via ONE
    -- batched GROUP BY aggregate (not a per-row correlated subquery
    -- re-evaluated once per topics row), narrowing the window the
    -- just-acquired locks above sit held while the scan work happens.
    UPDATE nexus.topics t
       SET doc_count = c.cnt
      FROM (
          SELECT ta.tenant_id, ta.topic_id, COUNT(*) AS cnt
            FROM nexus.topic_assignments ta
            JOIN (SELECT DISTINCT tenant_id, topic_id FROM new_rows) a
              ON a.tenant_id = ta.tenant_id AND a.topic_id = ta.topic_id
           GROUP BY ta.tenant_id, ta.topic_id
      ) c
     WHERE t.tenant_id = c.tenant_id AND t.id = c.topic_id;
    RETURN NULL;
END;
$fn$;
        </sql>
        <rollback>
            <!-- Restores taxonomy-003-1's original body verbatim. -->
            <sql splitStatements="false" stripComments="false">
CREATE OR REPLACE FUNCTION nexus.topics_doc_count_recount_ins()
    RETURNS TRIGGER
    LANGUAGE plpgsql
    SECURITY INVOKER
AS $fn$
BEGIN
    UPDATE nexus.topics t
       SET doc_count = (
           SELECT COUNT(*)
             FROM nexus.topic_assignments ta
            WHERE ta.topic_id = t.id
              AND ta.tenant_id = t.tenant_id
       )
      FROM (SELECT DISTINCT tenant_id, topic_id FROM new_rows) a
     WHERE t.id = a.topic_id
       AND t.tenant_id = a.tenant_id;
    RETURN NULL;
END;
$fn$;
