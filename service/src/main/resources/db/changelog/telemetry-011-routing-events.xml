<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-gjv9b PART 2 — routing_events: PG home for the RDR-121 routing-hook
    telemetry log, replacing ``~/.config/nexus/routing_log.jsonl`` (same Sam
    directive as telemetry-010-capability-census.xml).

    Append-only event log — mirrors relevance_log's shape (telemetry-001-
    baseline.xml): a BIGSERIAL id, no natural upsert key (a routing-hook
    firing is a genuinely distinct event every time, unlike the census's
    one-row-per-session collapse). Column shape mirrors
    ``log_routing_event``'s JSONL record field-for-field
    (conexus/hooks/scripts/routing/_lib.py):
      rule / outcome / ts           -> rule / outcome / ts
      tool_name                     -> tool_name (default '')
      command_fragment              -> command_fragment (default ''; the
                                        200-char cap stays a CLIENT-side
                                        truncation, same as today)
      escape_reason                 -> escape_reason (default ''; the
                                        300-char cap likewise client-side)
      (new) session_id              -> session_id (default ''); the JSONL
                                        record never carried this, but the
                                        PreToolUse payload's session_id is
                                        free to plumb through now that the
                                        record travels over the wire instead
                                        of straight to a per-host file, and
                                        a per-session breakdown is exactly
                                        what a future soak review would want

    ON THE WRITE PATH: routing hooks are standalone scripts with NO nexus
    import (RDR-121 § Contract) — they POST to this table's route directly
    via urllib, best-effort with a short timeout, and degrade to a metered
    drop (nexus.dropped_writes' JSONL format, hand-replicated inline since
    the hook cannot import nexus) on any failure. The hook's own exit code
    NEVER depends on this write succeeding.

    No ETL dedup index: this table has no fidelity-ETL import path in this
    bead's scope (mirrors nx_answer_steps' identical reasoning in
    telemetry-007-nx-answer-steps.xml) — the live POST is the only writer.

    Readers: GET /v1/telemetry/routing_events/list (TelemetryHandler),
    consumed by ``nexus.routing_stats.aggregate``/``escape_events`` (nexus-
    gjv9b PART 2 S11 doctrine: no writer ships without its reader).

    Grants: consolidated in grants-nexus-svc.xml (runAlways) — no per-store
    grant here.

    Placement: changelog TAIL, immediately after
    telemetry-010-capability-census.xml (the current tail) and before the
    grants-nexus-svc.xml runAlways block, matching the established
    late-append convention (D0.1). Renumbered from telemetry-010 to
    telemetry-011 on rebase over develop (nexus-nukn3's telemetry-009-
    index-failures.xml pushed capability_census from telemetry-009 to
    telemetry-010, which in turn pushed this file to telemetry-011).
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <!-- ── Changeset telemetry-011-1: routing_events table ─────────────────── -->
    <changeSet id="telemetry-011-1" author="nexus-gjv9b">
        <comment>Create routing_events table (event log; append-only, RDR-121 routing-hook telemetry)</comment>
        <sql splitStatements="true" stripComments="false">
CREATE TABLE nexus.routing_events (
    id                BIGSERIAL    NOT NULL,
    tenant_id         TEXT         NOT NULL,
    ts                TIMESTAMPTZ  NOT NULL,
    session_id        TEXT                   DEFAULT '',
    rule              TEXT         NOT NULL,
    outcome           TEXT         NOT NULL,
    tool_name         TEXT                   DEFAULT '',
    command_fragment  TEXT                   DEFAULT '',
    escape_reason     TEXT                   DEFAULT '',
    CONSTRAINT routing_events_pk PRIMARY KEY (id)
);

-- BTree indexes: time-range listing + per-rule aggregation, the same
-- profile relevance_log's own index rationale documents.
CREATE INDEX idx_routing_events_ts   ON nexus.routing_events (tenant_id, ts DESC);
CREATE INDEX idx_routing_events_rule ON nexus.routing_events (tenant_id, rule);
        </sql>
        <rollback>DROP TABLE IF EXISTS nexus.routing_events CASCADE</rollback>
    </changeSet>

    <!-- ── Changeset telemetry-011-2: routing_events RLS ───────────────────── -->
    <changeSet id="telemetry-011-2" author="nexus-gjv9b">
        <comment>RLS: ENABLE + FORCE + tenant_isolation policy on routing_events</comment>
        <sql splitStatements="true" stripComments="false">
ALTER TABLE nexus.routing_events ENABLE ROW LEVEL SECURITY;
ALTER TABLE nexus.routing_events FORCE ROW LEVEL SECURITY;
CREATE POLICY tenant_isolation ON nexus.routing_events
    USING      (tenant_id = current_setting('nexus.tenant', true))
    WITH CHECK (tenant_id = current_setting('nexus.tenant', true));
        </sql>
        <rollback>
            DROP POLICY IF EXISTS tenant_isolation ON nexus.routing_events;
            ALTER TABLE nexus.routing_events NO FORCE ROW LEVEL SECURITY;
            ALTER TABLE nexus.routing_events DISABLE ROW LEVEL SECURITY;
        </rollback>
    </changeSet>

</databaseChangeLog>
