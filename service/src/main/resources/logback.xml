<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <!-- Structured-ish: timestamp level logger event -->
            <!-- nexus-rph82: one clock for the service — log lines are UTC explicitly,
                 the same zone databasechangelog.dateexecuted is stamped in. -->
            <pattern>%d{ISO8601, UTC} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Reduce HikariCP noise during tests -->
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="org.jooq" level="WARN"/>
</configuration>
