<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-cbo4a batch 11 (Sam's rule, nexus-zrcj7: no SQL strings in Java, tests included): CREATE INDEX ${index} ON ${schema}.${table} (${column}) WHERE ${column} = '${value}'.
    A btree index with an equality predicate: an index the PCI catalog reader must NOT report (not HNSW, not a
    chunks leaf, not named pci_). Run through PgContainerHelper#createBtreeIndexWhereEquals, which validates the
    identifiers and escapes ${value} as a literal; runAlways, bookkeeping in its own table.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="btree-index-where-eq" author="nexus-cbo4a" runAlways="true">
        <sql>CREATE INDEX ${index} ON ${schema}.${table} (${column}) WHERE ${column} = '${value}'</sql>
    </changeSet>
</databaseChangeLog>
