<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-rfvyy.7.17: plants a function that returns a whole chunk row, one that selects over the chunk table, and an unrelated one
    in Liquibase XML instead of Java SQL strings (Sam's rule, nexus-zrcj7: no SQL strings in Java, tests included).
    jOOQ OSS has no CREATE FUNCTION. VectorSensitivityRouteParityTest plants these in a throwaway schema, ${probe}
    (a plain test identifier validated by the caller, never input), as a negative control for the chunk-text
    census: the census must see each planted function. The bodies hold dollar quotes, hence
    splitStatements="false". Run by that test directly, which drops ${probe} afterwards; runAlways, bookkeeping in
    its own table.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="census-probe-setof-leak" author="nexus-rfvyy.7.17" runAlways="true">
        <sql splitStatements="false" stripComments="false">
CREATE FUNCTION ${probe}.setof_leak(p text) RETURNS setof nexus.chunks
LANGUAGE sql AS $f$ SELECT * FROM nexus.chunks $f$
        </sql>
    </changeSet>

    <changeSet id="census-probe-star-leak" author="nexus-rfvyy.7.17" runAlways="true">
        <sql splitStatements="false" stripComments="false">
CREATE FUNCTION ${probe}.star_leak(p text) RETURNS table(chash bytea, n bigint)
LANGUAGE sql AS $f$ SELECT c.chash, 1::bigint FROM nexus.chunks c $f$
        </sql>
    </changeSet>

    <changeSet id="census-probe-unrelated" author="nexus-rfvyy.7.17" runAlways="true">
        <sql splitStatements="false" stripComments="false">
CREATE FUNCTION ${probe}.unrelated(p text) RETURNS int LANGUAGE sql AS $f$ SELECT 1 $f$
        </sql>
    </changeSet>
</databaseChangeLog>
