    <changeSet id="test-datamove-new-shape-check-1" author="nexus-f3yqd.2.14" runAlways="true">
        <sql splitStatements="false" stripComments="false">
ALTER TABLE dm_test.tenant_plain ADD CONSTRAINT tenant_plain_new_shape CHECK (n = 1) NOT VALID;
