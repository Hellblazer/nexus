<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-cbo4a batch 11 (Sam's rule, nexus-zrcj7: no SQL strings in Java, tests included): DROP POLICY ${policy} ON ${table}.
    jOOQ has no DROP POLICY. Not nexus_test.drop_policy: this one runs in databases the product changelog alone
    walked, which carry no nexus_test schema. Run through PgContainerHelper#dropPolicy, which renders ${table}
    from a jOOQ Table and validates ${policy}; runAlways, bookkeeping in its own table.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="drop-policy" author="nexus-cbo4a" runAlways="true">
        <sql>DROP POLICY ${policy} ON ${table}</sql>
    </changeSet>
</databaseChangeLog>
