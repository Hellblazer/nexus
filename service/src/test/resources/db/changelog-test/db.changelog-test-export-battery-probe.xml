<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-csayy.4: the tenant export battery's probe table, holding the column types no exported table of the registry
    has (smallint, a uuid key, arrays, interval, inet, real, date, time, json, bit, an identity column and a generated
    column), with row-level security on tenant_id like the product tables and SELECT for the service role. Seven rows of
    tenant t-battery-a (five filled, one all NULL, one with NULLs elsewhere) and one of t-battery-b. No SQL strings in
    Java, tests included; the jOOQ DDL has no CREATE POLICY. Run once by TenantExportBatteryTest#startAll.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="export-battery-probe" author="nexus-csayy.4">
        <sql>CREATE TABLE nexus.export_battery_probe (
            tenant_id text NOT NULL, k uuid NOT NULL, id bigint GENERATED ALWAYS AS IDENTITY, s smallint, i integer,
            big bigint, ba bigint[], ta text[], f4 real, f8 double precision, n numeric(12,4), b boolean, d date, t time,
            tsn timestamp, tstz timestamp with time zone, iv interval, ip inet, by bytea, j json, jb jsonb,
            v nexus.vector(3), bt bit(5), g integer GENERATED ALWAYS AS (i * 2) STORED, pad text,
            PRIMARY KEY (tenant_id, k))</sql>
        <sql>ALTER TABLE nexus.export_battery_probe ENABLE ROW LEVEL SECURITY</sql>
        <sql>CREATE POLICY probe_tenant ON nexus.export_battery_probe USING (tenant_id = current_setting('nexus.tenant', true))</sql>
        <sql>GRANT SELECT ON nexus.export_battery_probe TO nexus_svc</sql>
