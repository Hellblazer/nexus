<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-cbo4a batch 11 (Sam's rule, nexus-zrcj7: no SQL strings in Java, tests included): CREATE ROLE ${role} PASSWORD '${pass}' NOLOGIN.
    jOOQ has no CREATE ROLE. A role that has a password but may not log in (SQLSTATE 28000 on connect). Run
    through PgContainerHelper#createNologinRoleWithPassword, which validates ${role} as a plain identifier and
    ${pass} as a quote-free word; runAlways, bookkeeping in its own table.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="nologin-role-password" author="nexus-cbo4a" runAlways="true">
        <sql>CREATE ROLE ${role} PASSWORD '${pass}' NOLOGIN</sql>
    </changeSet>
</databaseChangeLog>
