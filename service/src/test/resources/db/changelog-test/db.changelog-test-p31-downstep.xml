<?xml version="1.0" encoding="UTF-8"?>
<!--
    RDR-229 P3.1 (nexus-p2m1x.17, residual R5; Sam's rule nexus-zrcj7: no SQL strings in Java, tests included): runs the
    operator down-step, db/rdr229/p31-downstep.sql (a main resource, generated from db/rdr229/p31-checks.tsv by
    scripts/rdr229_p31_downstep.py), through Liquibase so the test executes the operator's own file and carries no SQL text.
    Run through Rdr229P31DownStepIntegrationTest; runAlways, bookkeeping in its own table.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="p31-downstep" author="nexus-p2m1x.17" runAlways="true">
        <sqlFile path="db/rdr229/p31-downstep.sql" relativeToChangelogFile="false" splitStatements="true" stripComments="true"/>
    </changeSet>
</databaseChangeLog>
