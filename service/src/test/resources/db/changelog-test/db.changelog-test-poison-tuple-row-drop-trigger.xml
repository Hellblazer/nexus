<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-cbo4a: drops the poison-row trigger db.changelog-test-poison-tuple-row-install.xml put on
    nexus.tuples and leaves its function in place, in Liquibase XML instead of a Java SQL string (Sam's rule,
    nexus-zrcj7). TupleRepositoryTest drops only the trigger mid-test, so a later tick can release the row the
    trigger was failing; the function goes in db.changelog-test-poison-tuple-row-drop-function.xml, from the
    test's finally block. IF EXISTS, so the finally block can run it again. Run by that test directly;
    runAlways, bookkeeping in its own table.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="poison-tuple-row-drop-trigger" author="nexus-cbo4a" runAlways="true">
        <sql>DROP TRIGGER IF EXISTS nexus_test_poison_tuple_row_trigger ON nexus.tuples</sql>
    </changeSet>
</databaseChangeLog>
