<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-cbo4a batch 11 (Sam's rule, nexus-zrcj7: no SQL strings in Java, tests included): ALTER ROLE ${role} SET application_name TO 'empty_db_poison'.
    jOOQ has no ALTER ROLE. SharedClusterEmptyDatabaseTest plants a CLUSTER-wide role-level setting on the shared
    service role, the offender shape SharedCluster's reset-at-acquire must clear. The value is fixed here, never a
    parameter. Run through PgContainerHelper#setRoleApplicationNamePoison, which validates ${role}; runAlways,
    bookkeeping in its own table.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="role-application-name-poison" author="nexus-cbo4a" runAlways="true">
        <sql>ALTER ROLE ${role} SET application_name TO 'empty_db_poison'</sql>
    </changeSet>
</databaseChangeLog>
