<?xml version="1.0" encoding="UTF-8"?>
<!--
    nexus-cbo4a batch 11 (Sam's rule, nexus-zrcj7: no SQL strings in Java, tests included): GRANT CREATE ON SCHEMA ${schema} TO ${role}.
    jOOQ's grant resolves its target to a Table, so it can never name a schema. Run through
    PgContainerHelper#grantSchemaCreate, which validates both names; runAlways, bookkeeping in its own table.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="schema-create-grant" author="nexus-cbo4a" runAlways="true">
        <sql>GRANT CREATE ON SCHEMA ${schema} TO ${role}</sql>
    </changeSet>
</databaseChangeLog>
