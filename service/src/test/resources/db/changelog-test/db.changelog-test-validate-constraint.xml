<?xml version="1.0" encoding="UTF-8"?>
<!--
    RDR-229 P3.1 (nexus-p2m1x.17): ALTER TABLE ${table} VALIDATE CONSTRAINT ${constraint}, the operator's step after the orphan rows are gone.
    jOOQ has no VALIDATE CONSTRAINT, and nexus_test.validate_constraint is absent from the data-move and empty-database containers. Run through
    P31TestSql#validate, which renders ${table} from a jOOQ Table and validates ${constraint}; runAlways, bookkeeping in its own table.
-->
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="validate-constraint" author="nexus-p2m1x.17" runAlways="true">
        <sql>ALTER TABLE ${table} VALIDATE CONSTRAINT ${constraint}</sql>
    </changeSet>
</databaseChangeLog>
