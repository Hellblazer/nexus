  {
   "id": "equality-is-healthy",
   "owners": [
    {
     "prefix": "5.1",
     "next_seq": 3,
     "deactivated": false
    }
   ],
   "live": [
    "5.1.1",
    "5.1.3"
   ],
   "tombstoned": [],
   "expect": {
    "checked": 1,
    "drifted": []
   }
  },
