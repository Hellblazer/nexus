    {"id": "stub-position-class-key-only", "document": {"content_type": "pdf", "file_path": "/a/p21.pdf", "source_uri": "file:///a/p21.pdf", "meta": {}}, "chunk": {"section_title": "S"}, "expect": {"stub": true, "source": "file:///a/p21.pdf"}},
    {"id": "stub-legacy-class-key-only", "document": {"content_type": "pdf", "file_path": "/a/p22.pdf", "source_uri": "file:///a/p22.pdf", "meta": {}}, "chunk": {"git_branch": "main"}, "expect": {"stub": true, "source": "file:///a/p22.pdf"}},
