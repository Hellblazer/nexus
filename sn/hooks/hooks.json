{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/session_start.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/subagent_start.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__plugin_sn_.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/auto_approve_sn_mcp.py"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "mcp__plugin_sn_.*",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": [
              "tool",
              "run",
              "--directory",
              "${CLAUDE_PLUGIN_ROOT}",
              "--no-config",
              "--quiet",
              "--python",
              ">=3.12",
              "python",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/auto_approve_sn_mcp.py"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  }
}
