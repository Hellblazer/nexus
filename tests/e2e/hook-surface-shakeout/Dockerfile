# RDR-215 hook-surface shakeout image. Built by run.sh from a staging dir
# holding wheel/, plugin/ (hooks.json UNTRIMMED except the two entries that
# would replace the wheel under test), checkout/ (a real repo, which is what
# rdr208-mvv's container lacks and why its hooks.json had to be trimmed),
# settings.json and the drive helpers. The Claude Code sessions are REAL:
# run.sh mounts a fresh oauth credential read-only at run time.
FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1
# procps: nexus.session.find_immediate_claude_pid walks ancestry with ps.
# tmux: the session is driven through a private tmux socket.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git jq procps tmux \
        python3 python3-venv python3-pip \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip3 install --no-cache-dir --break-system-packages uv
RUN useradd -m -s /bin/bash nexus
USER nexus
WORKDIR /home/nexus
ENV PATH="/home/nexus/nxenv/bin:/home/nexus/.local/bin:${PATH}" \
    NX_HOOK_PYTHON=/home/nexus/nxenv/bin/python
RUN curl -fsSL https://claude.ai/install.sh | bash \
    && /home/nexus/.local/bin/claude --version
RUN uv venv --python 3.12 /home/nexus/nxenv
COPY --chown=nexus:nexus wheel/ /home/nexus/wheel/
RUN uv pip install --python /home/nexus/nxenv -r /home/nexus/wheel/requirement.txt
COPY --chown=nexus:nexus plugin/ /home/nexus/plugin/
# The repo the checkout-reading hooks want. Owned by the run user and made a
# real git repo: `rdr` walks docs/rdr, the routing rules resolve a repo root,
# and several hooks compare --git-dir against --git-common-dir.
COPY --chown=nexus:nexus checkout/ /home/nexus/repo/
RUN cd /home/nexus/repo \
    && git init -q \
    && git config user.email shakeout@example.invalid \
    && git config user.name shakeout \
    && git add -A \
    && git commit -qm "shakeout checkout" \
    && git checkout -qb develop
COPY --chown=nexus:nexus settings.json /home/nexus/.claude/settings.json
COPY --chown=nexus:nexus shakeout_in_container.sh hook_census.py \
     send.py assistant_said.py turn_end.py mcp_tee.sh hooks.json.original /home/nexus/
# The command-tier shims: one per entry, each appending a census row before it
# execs the real handler. Generated by run.sh from the manifest, so the set is
# derived from what ships rather than hand-kept here.
COPY --chown=nexus:nexus shims/ /home/nexus/shims/
RUN chmod +x /home/nexus/mcp_tee.sh /home/nexus/shims/*.sh && mkdir -p /home/nexus/run
ENTRYPOINT ["/bin/bash", "/home/nexus/shakeout_in_container.sh"]
