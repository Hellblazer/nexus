# syntax=docker/dockerfile:1
# nexus-p78a0 (RDR-180) + nexus-eo3qv (post-cutover REDESIGN) —
# CHASH-WINDOW rehearsal box.
#
# Same quarantine posture as Dockerfile.cold / Dockerfile.era-hop (no
# system PostgreSQL, no pre-staged engine, no ONNX model). NO pre-installed
# conexus AT ALL — the driver `uv tool install`s the last pre-cohort
# release (conexus==$OLD_RELEASE) from real PyPI at runtime, then
# force-reinstalls the staged worktree wheel over it into the SAME tool
# venv. A TOOL install (not a plain venv) because running_from_tool_install()
# gates the version-transition finish pass whose [upgrade-finish] callout
# line is the surface under test.
#
# nexus-eo3qv: NO engine binary of any kind travels in this image. Both
# engines are acquired at runtime by the product's own code — the
# pre-cohort engine ($OLD_ENGINE_TAG, a HISTORICAL PIN — see run.sh's
# CHASH_OLD_ENGINE_TAG comment) via `nx daemon service install-binary`,
# and the current floor engine via converge_engine's real download path
# when the version transition fires on the first new-client invocation.
# Same runtime-acquisition posture as Dockerfile.era-hop /
# Dockerfile.package-upgrade: the harness never supplies an engine binary,
# because if it did the window-close assertions would prove nothing about
# the real upgrade path.
FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1

# ca-certificates (PyPI + GitHub release + HF downloads), git (Catalog.init),
# python for the /version JSON probe helper + uv bootstrap, libgomp1 (the
# native binary's bundled ONNX runtime dlopens OpenMP). NO postgresql — the
# relocatable PG bundle is cold-acquired + provisioned by nx itself.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git \
        python3 python3-venv python3-pip \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Non-root user — initdb (run by `nx init --service`) refuses to run as root.
RUN useradd -m -s /bin/bash nexus
# ~/.local/bin is where `uv tool install` links the nx executable.
ENV PATH="/home/nexus/.local/bin:${PATH}"

RUN pip3 install --no-cache-dir --break-system-packages uv

USER nexus
WORKDIR /home/nexus

# The worktree wheel (real PEP 427 name preserved) and the driver. No
# engine artifact — both engines are acquired at runtime by the product's
# own code (see the header comment above).
COPY --chown=nexus:nexus worktree-wheel/ /home/nexus/worktree-wheel/
COPY --chown=nexus:nexus rehearse_chash_window.sh /home/nexus/rehearse_chash_window.sh

ENTRYPOINT ["/bin/bash", "/home/nexus/rehearse_chash_window.sh"]
