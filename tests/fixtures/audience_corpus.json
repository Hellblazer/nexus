{
  "comment": "Parity corpus for the audience helper (nexus-sby49.3). Each row builds a layout under a tmp dir, picks a payload and a flag state, and names the answer of each predicate. The plugin copy (conexus/hooks/scripts/_audience.py), the src copy (src/nexus/hooks/_audience.py) and the previous release's plugin copy (git show <pinned ref>:...) must all give it. A row the previous copy cannot know sets prev_release to false. Paths are relative to the tmp dir and use '/'. A file entry is a file, a dir entry a directory, a link entry a symlink (posix only: a row with a link sets posix_only).",
  "markers": ["scripts/agent-worktree-preflight.sh", ".nexus/dev-process.json"],
  "rows": [
    {"id": "plain-repo-no-flag", "layout": [{"p": "r/.git", "k": "dir"}], "payload": {"cwd": "r"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "plain-repo-flag", "layout": [{"p": "r/.git", "k": "dir"}], "payload": {"cwd": "r"}, "flag": true,
     "expect": {"account_flag": true, "nexus_repo": false, "maintainer": true}},
    {"id": "phase1-marker-no-flag", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/scripts/agent-worktree-preflight.sh", "k": "file"}],
     "payload": {"cwd": "r"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": true, "maintainer": true}},
    {"id": "phase2-marker-no-flag", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file", "c": "{}"}],
     "payload": {"cwd": "r"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": true, "maintainer": true}},
    {"id": "both-markers", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}, {"p": "r/scripts/agent-worktree-preflight.sh", "k": "file"}],
     "payload": {"cwd": "r"}, "flag": true,
     "expect": {"account_flag": true, "nexus_repo": true, "maintainer": true}},
    {"id": "marked-repo-subdir", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}, {"p": "r/src/pkg", "k": "dir"}],
     "payload": {"cwd": "r/src/pkg"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": true, "maintainer": true}},
    {"id": "marked-repo-cwd-in-dot-git", "layout": [{"p": "r/.git/hooks", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}],
     "payload": {"cwd": "r/.git/hooks"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": true, "maintainer": true}},
    {"id": "marked-repo-cwd-gone", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}],
     "payload": {"cwd": "r/deleted/worktree"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": true, "maintainer": true}},
    {"id": "nested-repo-inside-marked-no-flag", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}, {"p": "r/vendor/lib/.git", "k": "dir"}],
     "payload": {"cwd": "r/vendor/lib"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "nested-repo-inside-marked-flag", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}, {"p": "r/vendor/lib/.git", "k": "dir"}],
     "payload": {"cwd": "r/vendor/lib"}, "flag": true,
     "expect": {"account_flag": true, "nexus_repo": false, "maintainer": true}},
    {"id": "submodule-git-file", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}, {"p": "r/sub/.git", "k": "file", "c": "gitdir: ../.git/modules/sub\n"}],
     "payload": {"cwd": "r/sub"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "linked-worktree-marked", "layout": [{"p": "wt/.git", "k": "file", "c": "gitdir: /nonexistent\n"}, {"p": "wt/.nexus/dev-process.json", "k": "file"}],
     "payload": {"cwd": "wt"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": true, "maintainer": true}},
    {"id": "linked-worktree-older-branch-no-flag", "layout": [{"p": "wt/.git", "k": "file", "c": "gitdir: /nonexistent\n"}],
     "payload": {"cwd": "wt"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "linked-worktree-older-branch-flag", "layout": [{"p": "wt/.git", "k": "file", "c": "gitdir: /nonexistent\n"}],
     "payload": {"cwd": "wt"}, "flag": true,
     "expect": {"account_flag": true, "nexus_repo": false, "maintainer": true}},
    {"id": "no-git-anywhere", "layout": [{"p": "plain/dir", "k": "dir"}], "payload": {"cwd": "plain/dir"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "marker-above-the-first-git", "layout": [{"p": "o/.nexus/dev-process.json", "k": "file"}, {"p": "o/inner/.git", "k": "dir"}],
     "payload": {"cwd": "o/inner"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "marker-is-a-directory", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "dir"}],
     "payload": {"cwd": "r"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "flag-is-a-directory", "layout": [{"p": "r/.git", "k": "dir"}], "payload": {"cwd": "r"}, "flag": "dir",
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "symlinked-cwd-to-marked-repo", "posix_only": true,
     "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}, {"p": "elsewhere/here", "k": "link", "t": "r"}],
     "payload": {"cwd": "elsewhere/here"}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": true, "maintainer": true}},
    {"id": "project-dir-env-names-a-marked-repo", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}],
     "payload": {}, "env_project_dir": "r", "flag": false,
     "expect": {"account_flag": false, "nexus_repo": true, "maintainer": true}},
    {"id": "payload-cwd-wins-over-project-dir", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}, {"p": "u/.git", "k": "dir"}],
     "payload": {"cwd": "u"}, "env_project_dir": "r", "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "unsubstituted-cwd", "layout": [], "payload": {"cwd": "${cwd}"}, "raw_cwd": true, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "relative-cwd", "layout": [{"p": "r/.git", "k": "dir"}, {"p": "r/.nexus/dev-process.json", "k": "file"}],
     "payload": {"cwd": "relative/path"}, "raw_cwd": true, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "nul-byte-cwd", "layout": [], "payload": {"cwd": "bad\u0000path"}, "raw_cwd": true, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "empty-payload-no-flag", "layout": [], "payload": {}, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "empty-payload-flag", "layout": [], "payload": {}, "flag": true,
     "expect": {"account_flag": true, "nexus_repo": false, "maintainer": true}},
    {"id": "payload-is-not-a-dict", "layout": [], "payload": null, "flag": false,
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false}},
    {"id": "hosts-file-lines-commas-comments", "layout": [], "payload": {}, "flag": false,
     "home_files": [{"p": ".config/nexus/remote-test-hosts", "c": "chas, qwent # lab hosts\n# whole-line comment\nhellmini\n\n"}],
     "expect": {"account_flag": false, "nexus_repo": false, "maintainer": false, "remote_test_hosts": ["chas", "hellmini", "qwent"]}},
    {"id": "hosts-file-absent", "layout": [], "payload": {}, "flag": true,
     "expect": {"account_flag": true, "nexus_repo": false, "maintainer": true, "remote_test_hosts": []}}
  ]
}
