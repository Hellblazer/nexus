{
  "comment": "The format of the setup directory, pinned from both sides. conexus/launch/nx_setup.py (a plugin script) writes it; the nx doctor row 'Plugin setup' (src/nexus/health.py) reads it; the two ship as separate release artifacts. tests/hooks/test_nx_setup.py (the writer) and tests/test_doctor_setup_row.py (the reader) both read THIS file, so neither side can change the format alone. Each case is a setup directory: status is the body of status.json (null: no file), error is the body of status.error, heartbeat_age_seconds is the age of lock/heartbeat (null: no lock), not_now makes the marker, log_text (optional; absent means no log file) is the text of setup.log. The text {LOG} in a value stands for the path of setup.log in the directory under test. view is what nx_setup.status_view reports; row is what the doctor row reports: outcome is one of not-applicable, ok, warn, and every string in contains must appear in its detail (and in its fix suggestions when named there).",
  "stale_after_seconds": 60,
  "files": {
    "status": "status.json",
    "error": "status.error",
    "log": "setup.log",
    "lock": "lock",
    "heartbeat": "lock/heartbeat",
    "marker": "not-now"
  },
  "states": ["running", "done", "doctor-failed", "failed", "unsupported"],
  "terminal_states": ["done", "doctor-failed", "failed", "unsupported"],
  "writer_keys": {
    "running": ["state", "stage", "mode", "log", "started_at", "updated_at", "message", "next"],
    "failed": ["state", "stage", "mode", "log", "started_at", "updated_at", "message", "next", "failed_step"],
    "doctor-failed": ["state", "stage", "mode", "log", "started_at", "updated_at", "message", "next", "doctor", "doctor_failing"],
    "done": ["state", "stage", "mode", "log", "started_at", "updated_at", "message", "next"],
    "unsupported": ["state", "stage", "mode", "log", "started_at", "updated_at", "message", "next"]
  },
  "writer_error_keys": ["state", "stage", "failed_step", "mode", "log", "updated_at", "message", "next"],
